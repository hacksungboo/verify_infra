# ===== 이미지 =====
REGISTRY=ghcr.io/hacksungboo
IMAGE_TAG=latest

# ===== DB 연결 =====
# tunnel: SSH로 DB 서버 1521을 끌어옴 (보안 목록 권한 없을 때 기본값)
COMPOSE_PROFILES=tunnel
DB_HOST=db-tunnel
DB_PORT=1521
DB_SERVICE=FREEPDB1
DB_USER=verifi
# db-server/.env 의 APP_USER_PASSWORD 와 같은 값. URL에 들어가므로 영문·숫자만 쓰세요
DB_PASSWORD=
# 시스템 화면에 표시할 이름
DB_SERVER_LABEL=team-4-2 · Oracle 23ai Free

# SSH 터널 대상 (DB 서버). 같은 VCN이면 사설 IP가 더 좋다
DB_SSH_HOST=131.186.25.47
DB_SSH_USER=opc
# DB 서버 접속 키(team-4-2.key)를 이 경로에 복사해 두세요
DB_SSH_KEY_PATH=./keys/db.key

# ===== 앱 =====
# openssl rand -hex 32
JWT_SECRET=
DEMO_EMAIL=demo@hanbit.co.kr
DEMO_PASSWORD=verifi2026
AI_PROVIDER=rule
OPENAI_API_KEY=
PIPELINE_STEP_DELAY=0.35
PUBLIC_HOSTNAME=verifi.ccmall.shop

# ===== Cloudflare =====
# Zero Trust → Networks → Tunnels → (터널) → 설치 명령의 eyJ... 로 시작하는 토큰
CLOUDFLARE_TUNNEL_TOKEN=
